# A3 Backend Environment Configuration
# Copy this file to .env.local for local development.

MODE=local
DATABASE_URL=sqlite:///./a3_local.db
STORAGE_PATH=./data/uploads

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Local bootstrap account. If password is blank, A3 generates a random one and logs it once.
LOCAL_ADMIN_EMAIL=admin@localhost
LOCAL_ADMIN_PASSWORD=

# Cloud mode
CLOUD_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Authentication
# REQUIRED outside local development.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
