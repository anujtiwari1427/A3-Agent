# A3 Platform Environment Configuration
MODE=local

# Local Mode Database & Storage
DATABASE_URL=sqlite:///./a3_local.db
STORAGE_PATH=./data/uploads

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Authentication Secrets
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRE_MINUTES=10080

# Cloud Mode Optional Overrides (PostgreSQL / Supabase / Groq)
# CLOUD_DATABASE_URL=postgresql://user:password@localhost:5432/a3
# GROQ_API_KEY=gsk_your_groq_api_key_here
