# A3 Backend Environment Configuration
# Copy this file to .env.local for local development.

MODE=local
DATABASE_URL=sqlite:///./a3_local.db
STORAGE_PATH=./data/uploads

# Security License Key for Local Mode (Default: 7710916655)
LOCAL_LICENSE_KEY=7710916655

# Google OAuth 2.0 / Identity Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud mode
CLOUD_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Authentication
# REQUIRED outside local development.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
